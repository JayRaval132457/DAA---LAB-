#include <iostream>
#include <vector>
#include <climits>
#include <chrono>

using namespace std;
using namespace chrono;

// Dynamic Programming approach
int coinChange(vector<int>& coins, int amount)
{
    vector<int> dp(amount + 1, INT_MAX);

    // Base case
    dp[0] = 0;

    // Calculate minimum coins
    for (int i = 1; i <= amount; i++)
    {
        for (int coin : coins)
        {
            if (coin <= i && dp[i - coin] != INT_MAX)
            {
                dp[i] = min(dp[i], dp[i - coin] + 1);
            }
        }
    }

    if (dp[amount] == INT_MAX)
        return -1;

    return dp[amount];
}

int main()
{
    int n, amount;

    // Enter number of coins
    cout << "Enter number of coin denominations: ";
    cin >> n;

    vector<int> coins(n);

    // Enter coin values
    cout << "Enter coin values: ";
    for (int i = 0; i < n; i++)
    {
        cin >> coins[i];
    }

    // Enter target amount
    cout << "Enter target amount: ";
    cin >> amount;

    // Start execution time
    auto start = high_resolution_clock::now();

    // Find minimum number of coins
    int result = coinChange(coins, amount);

    // End execution time
    auto end = high_resolution_clock::now();

    // Calculate execution time
    auto executionTime =
        duration_cast<nanoseconds>(end - start).count();

    // Display result
    cout << "\n----- Result -----" << endl;

    if (result == -1)
        cout << "Target amount cannot be formed." << endl;
    else
        cout << "Minimum number of coins = " << result << endl;

    cout << "Execution time = "
         << executionTime << " nanoseconds" << endl;

    cout << "\nTime Complexity: O(n * A)" << endl;
    cout << "Space Complexity: O(A)" << endl;

    return 0;
}
